                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT
    p.ProductID,
    p.ProductName,
    SUM(sd.Quantity)                                      AS TotalQty,
    SUM(CAST(sd.TotalSalePricePerProduct AS decimal(18,2))) AS TotalRevenue
